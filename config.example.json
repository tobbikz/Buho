{
  "store": {
    "url": "postgres://buho:buho@127.0.0.1:55432/buho"
  },
  "collector": {
    "statementTimeoutMs": 5000,
    "connectTimeoutMs": 5000,
    "instanceCycleBudgetMs": 20000,
    "retention": {
      "rawDays": 7,
      "rollup5mDays": 30,
      "rollup1hDays": 400,
      "lockEpisodeDays": 30,
      "statementDays": 14
    }
  },
  "instances": [
    {
      "alias": "datalake-local",
      "environment": "dev",
      "host": "127.0.0.1",
      "port": 5432,
      "hostMetrics": {
        "_comentario": "CPU/memoria/disco del servidor. PostgreSQL no los expone: hay que leer /proc. 'local' si Búho corre en el mismo host, 'ssh' para leerlos sin instalar nada en el servidor, 'none' u omitido para no recogerlos.",
        "source": "ssh",
        "target": "buho@servidor-bd",
        "identityFile": "/etc/buho/id_ed25519",
        "dataDirectory": "/var/lib/postgresql/16/main"
      },
      "database": "datalake",
      "user": "buho_monitor",
      "password": "cambiar",
      "tags": {
        "grupo": "produccion-cr",
        "equipo": "datos"
      },
      "logs": {
        "source": "journal",
        "access": "ssh",
        "target": "usuario@servidor",
        "unit": "postgresql"
      }
    },
    {
      "alias": "mariadb-prod",
      "engine": "mariadb",
      "host": "10.0.0.20",
      "port": 3306,
      "database": "",
      "user": "buho_monitor",
      "password": "CAMBIAR",
      "environment": "prod",
      "_comentario": "MariaDB: métricas, consultas, bloqueos, sesiones, flujo e inventario. Ver INSTALL.md para el usuario de monitoreo.",
      "tags": {
        "grupo": "produccion-cr",
        "equipo": "datos"
      }
    },
    {
      "alias": "mssql-prod",
      "engine": "mssql",
      "host": "10.0.0.30",
      "port": 1433,
      "database": "master",
      "user": "buho_monitor",
      "password": "CAMBIAR",
      "environment": "prod",
      "_comentario": "En SQL Server el usuario necesita VIEW SERVER STATE y lectura sobre msdb para ver el catálogo de respaldos y los jobs del Agent.",
      "tags": {
        "grupo": "produccion-cr",
        "equipo": "datos"
      }
    },
    {
      "alias": "mongo-prod",
      "engine": "mongodb",
      "host": "10.0.0.40",
      "port": 27017,
      "database": "admin",
      "user": "buho_monitor",
      "password": "CAMBIAR",
      "environment": "prod",
      "_comentario": "MongoDB v0.4: serverStatus, dbStats e inventario. Rol clusterMonitor (o readAnyDatabase + clusterMonitor). Sin profiler todavía.",
      "tags": {
        "grupo": "produccion-cr",
        "equipo": "datos"
      }
    }
  ]
}
