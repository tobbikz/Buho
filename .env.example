# Copiar a .env, o dejar que ./install.sh lo genere con secretos aleatorios.
#
# install.sh no sobrescribe un .env existente: regenerar BUHO_AUTH_SECRET
# cierra todas las sesiones abiertas de la consola.

# Contraseña del PostgreSQL interno donde Búho guarda su historia. No es la de
# ninguna base monitoreada.
BUHO_STORE_PASSWORD=cambiar-esto

# Firma las sesiones de la consola. Generar con: openssl rand -base64 36
BUHO_AUTH_SECRET=

# Contraseña de arranque: entra como administrador mientras no exista ninguna
# cuenta, para poder crear la primera. Después deja de servir.
BUHO_AUTH_PASSWORD=

# Activar sólo si la consola termina TLS ella misma. Detrás de un proxy que ya
# lo termina, exigir secure impide entrar.
BUHO_AUTH_COOKIE_SECURE=false

# Puertos en el host, por si los de siempre están tomados.
# BUHO_WEB_PORT=3100
# BUHO_STORE_PORT=55432

# Zona horaria de las líneas base ("qué es normal un martes a las 3pm"). Por
# omisión, la del sistema donde corre cada proceso.
# BUHO_TZ=America/Costa_Rica
