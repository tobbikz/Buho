{
  "store": {
    "url": "postgres://buho:buho@127.0.0.1:55432/buho"
  },
  "collector": {
    "statementTimeoutMs": 10000,
    "connectTimeoutMs": 15000,
    "instanceCycleBudgetMs": 45000,
    "retention": {
      "rawDays": 7,
      "rollup5mDays": 30,
      "rollup1hDays": 90,
      "lockEpisodeDays": 30,
      "statementDays": 30,
      "planDays": 30,
      "logDays": 30,
      "checkResultDays": 30,
      "collectorEventDays": 30,
      "healthScoreDays": 30,
      "unreachableAfterMinutes": 5
    }
  },
  "instances": [
    {
      "alias": "kafka-lab",
      "engine": "kafka",
      "host": "127.0.0.1",
      "port": 19092,
      "database": "",
      "user": "",
      "environment": "lab",
      "kafka": {
        "brokers": ["127.0.0.1:19092"],
        "consumerGroups": ["buho-lab-group"]
      }
    },
    {
      "alias": "cdc-lab",
      "engine": "cdc",
      "host": "127.0.0.1",
      "port": 19092,
      "database": "",
      "user": "",
      "environment": "lab",
      "cdc": {
        "kafka": {
          "brokers": ["127.0.0.1:19092"],
          "consumerGroups": ["buho-lab-group"]
        },
        "topics": ["buho.lab.events"],
        "applyGroups": ["buho-lab-group"],
        "datasyncHealthUrl": "http://127.0.0.1:18999/health",
        "maxApplyLagSeconds": 60
      }
    },
    {
      "alias": "airflow-mock",
      "engine": "airflow",
      "host": "127.0.0.1",
      "port": 18998,
      "database": "",
      "user": "admin",
      "password": "admin",
      "environment": "lab",
      "airflow": {
        "baseUrl": "http://127.0.0.1:18998",
        "apiVersion": "v1"
      },
      "actions": {
        "enabled": true,
        "allowAirflowDagPause": true
      }
    }
  ]
}
