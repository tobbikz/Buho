{
  "name": "buho",
  "version": "1.7.1",
  "private": true,
  "type": "module",
  "description": "B\u00faho \u2014 monitor de bases de datos on-prem. PostgreSQL primero.",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "check": "tsx apps/cli/src/main.ts",
    "collector": "tsx apps/collector/src/main.ts",
    "web": "PORT=3100 node apps/web/.next/standalone/apps/web/server.js",
    "web:dev": "npm run dev -w @buho/web",
    "web:build": "npm run build -w @buho/web && npm run web:sync-standalone",
    "web:sync-standalone": "mkdir -p apps/web/.next/standalone/apps/web/.next && rm -rf apps/web/.next/standalone/apps/web/.next/static apps/web/.next/standalone/apps/web/public && cp -a apps/web/.next/static apps/web/.next/standalone/apps/web/.next/static && cp -a apps/web/public apps/web/.next/standalone/apps/web/public",
    "web:start": "npm run start -w @buho/web",
    "migrate": "tsx packages/store/src/migrate.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p apps/web/tsconfig.json --noEmit",
    "verify:console": "node scripts/verify-console.mjs",
    "verify:v1": "node scripts/verify-v1.mjs",
    "test:retention": "node scripts/test-retention.mjs",
    "verify:parity": "node scripts/verify-parity.mjs",
    "verify:flow": "node scripts/probe-fleet-flow.mjs",
    "ensayo:instalacion": "bash scripts/ensayo-instalacion.sh",
    "ensayo:engines": "bash scripts/ensayo-engines.sh",
    "carga:sintetica": "node scripts/carga-sintetica.mjs",
    "ensayo:alerts": "tsx scripts/ensayo-alerts.ts",
    "alerts:import": "tsx scripts/import-alert-catalog.ts",
    "verify:responsive": "node scripts/responsive-smoke.mjs",
    "otel:emit": "node scripts/otel-demo-emit.mjs",
    "smoke:otlp": "node scripts/smoke-otlp.mjs",
    "apm:ebpf": "bash scripts/apm-ebpf.sh",
    "apm:ebpf:status": "bash scripts/apm-ebpf.sh status",
    "apm:ebpf:stop": "bash scripts/apm-ebpf.sh stop",
    "seed:demo-users": "tsx scripts/seed-demo-users.ts",
    "test:sensors": "npm run test -w @buho/sensors",
    "lab:infra:snmp": "node lab/infra/fake-snmp-agent.mjs",
    "lab:infra:seed": "tsx scripts/seed-infra-lab.ts",
    "lab:infra:discover": "tsx scripts/infra-discover.ts",
    "lab:infra:trap": "tsx scripts/inject-snmp-trap.ts"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.23.1",
    "playwright": "^1.62.1",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "nodemailer": "^10.0.0"
  }
}
